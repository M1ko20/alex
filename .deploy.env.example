# FTP login for npm run deploy. Copy to .deploy.env (not in git) and fill in.
# WEDOS: customer panel → Webhosting → your hosting → FTP.
FTP_HOST=ftp.example.cz
FTP_USER=
FTP_PASSWORD=
# The folder of the website on the FTP: www for the main domain of the hosting,
# www/domains/<domain> for another domain on it
FTP_DIR=www
